# Server port (default 3001)
# PORT=3001

# Frontend origin for CORS. When hosting, set to your site URL (e.g. https://yourdomain.com).
# CLIENT_ORIGIN=https://yourdomain.com

# Database (if using Prisma). Uncomment and set when you add persistence.
# DATABASE_URL="postgresql://user:password@localhost:5432/resume_db"

# JWT secret for auth. Generate a strong random string for production.
# JWT_SECRET=your-super-secret-key-change-in-production

# OpenAI API key (for AI features). Optional; leave unset to disable AI.
# OPENAI_API_KEY=sk-...
