generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String?
  name      String?
  avatarUrl String?
  provider  String   @default("email") // email, google, linkedin
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  resumes      Resume[]
  applications JobApplication[]
  subscription Subscription?
}

model Resume {
  id             String   @id @default(uuid())
  userId         String
  title          String
  content        Json     // Stores the entire resume structure
  style          Json?    // Stores custom styling preferences
  score          Int?     // Last ATS score
  targetJobTitle String?
  isPublic       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user       User       @relation(fields: [userId], references: [id])
  analyses   Analysis[]
}

model JobApplication {
  id          String   @id @default(uuid())
  userId      String
  company     String
  role        String
  status      String   @default("APPLIED") // APPLIED, INTERVIEWING, REJECTED, OFFER
  jobDescription String? // Full text of JD
  
  appliedDate DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model Analysis {
  id        String   @id @default(uuid())
  resumeId  String
  score     Int
  feedback  Json     // Detailed breakdown of score
  
  createdAt DateTime @default(now())

  resume Resume @relation(fields: [resumeId], references: [id])
}

model Subscription {
  id             String   @id @default(uuid())
  userId         String   @unique
  plan           String   @default("FREE") // FREE, PRO, PREMIUM, ENTERPRISE
  status         String   @default("ACTIVE")
  startDate      DateTime @default(now())
  endDate        DateTime?

  user User @relation(fields: [userId], references: [id])
}
