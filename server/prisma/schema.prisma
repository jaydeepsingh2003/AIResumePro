generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String?
  name      String?
  avatarUrl String?
  provider  String   @default("email") // email, google, linkedin
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  resumes      Resume[]
  applications JobApplication[]
  subscription Subscription?
}

model Resume {
  id             String   @id @default(uuid())
  userId         String
  title          String
  content        Json     // Stores the entire resume structure
  style          Json?    // Stores custom styling preferences
  score          Int?     // Last ATS score
  targetJobTitle String?
  isPublic       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  
  templateId     String?
  template       Template? @relation(fields: [templateId], references: [id])

  user       User       @relation(fields: [userId], references: [id])
  analyses   Analysis[]
}

model Template {
  id          String   @id
  name        String
  description String?
  category    String   // corporate, tech, creative, etc.
  isPremium   Boolean  @default(false)
  isActive    Boolean  @default(true)
  thumbnailUrl String?
  
  layout      Json     // Layout configuration
  styles      Json     // Global style configuration
  sections    Json     // Section-specific overrides
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  resumes     Resume[]
}

model JobApplication {
  id          String   @id @default(uuid())
  userId      String
  company     String
  role        String
  status      String   @default("APPLIED") // APPLIED, INTERVIEWING, REJECTED, OFFER
  jobDescription String? // Full text of JD
  
  appliedDate DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model Analysis {
  id        String   @id @default(uuid())
  resumeId  String
  score     Int
  feedback  Json     // Detailed breakdown of score
  
  createdAt DateTime @default(now())

  resume Resume @relation(fields: [resumeId], references: [id])
}

model Subscription {
  id             String   @id @default(uuid())
  userId         String   @unique
  plan           String   @default("FREE") // FREE, PRO, PREMIUM, ENTERPRISE
  status         String   @default("ACTIVE")
  startDate      DateTime @default(now())
  endDate        DateTime?

  user User @relation(fields: [userId], references: [id])
}
